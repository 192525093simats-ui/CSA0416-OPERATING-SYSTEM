#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define N 5

sem_t chopstick[N];
pthread_t philosopher[N];

void* dine(void* num) {
    int id = *(int*)num;
    int left = id;
    int right = (id + 1) % N;

    while (1) {
        printf("Philosopher %d is thinking.\n", id);
        sleep(1);

        // Avoid deadlock: odd philosopher picks right first, even picks left first
        if (id % 2 == 0) {
            sem_wait(&chopstick[left]);
            printf("Philosopher %d picked up left chopstick %d.\n", id, left);
            sem_wait(&chopstick[right]);
            printf("Philosopher %d picked up right chopstick %d.\n", id, right);
        } else {
            sem_wait(&chopstick[right]);
            printf("Philosopher %d picked up right chopstick %d.\n", id, right);
            sem_wait(&chopstick[left]);
            printf("Philosopher %d picked up left chopstick %d.\n", id, left);
        }

        printf("Philosopher %d is eating.\n", id);
        sleep(2);

        sem_post(&chopstick[left]);
        sem_post(&chopstick[right]);
        printf("Philosopher %d put down chopsticks %d and %d.\n", id, left, right);
    }
    return NULL;
}

int main() {
    int ids[N];

    for (int i = 0; i < N; i++)
        sem_init(&chopstick[i], 0, 1);

    for (int i = 0; i < N; i++) {
        ids[i] = i;
        pthread_create(&philosopher[i], NULL, dine, &ids[i]);
    }

    for (int i = 0; i < N; i++)
        pthread_join(philosopher[i], NULL);

    for (int i = 0; i < N; i++)
        sem_destroy(&chopstick[i]);

    return 0;
}
